<UserControl x:Class="DemoApiCalls.CustomControls.TestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DemoApiCalls.CustomControls"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:DemoApiCalls.Converters"
             xmlns:viewModel="clr-namespace:DemoApiCalls.ViewModels"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewModel:TestViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>

        <converters:BoolToOnOffConverter x:Key="OnOffConverter"/>
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="Blue"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="Green">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" Margin="10">
                
                <ToggleButton 
                              Content="{Binding IsButton1On, Converter={StaticResource OnOffConverter}}"
                              IsChecked="{Binding IsButton1On}" Style="{StaticResource ToggleButtonStyle}" Width="200" Height="60" Margin="10"/>
                <ToggleButton Content="{Binding IsButton2On, Converter={StaticResource OnOffConverter}}"  IsChecked="{Binding IsButton2On}" Style="{StaticResource ToggleButtonStyle}"  Width="200" Height="60" Margin="10"/>
                <ToggleButton Content="{Binding IsButton3On, Converter={StaticResource OnOffConverter}}" IsChecked="{Binding IsButton3On}" Style="{StaticResource ToggleButtonStyle}"  Width="200" Height="60" Margin="10"/>
                <ToggleButton Content="{Binding IsButton4On, Converter={StaticResource OnOffConverter}}"  IsChecked="{Binding IsButton4On}" Style="{StaticResource ToggleButtonStyle}"  Width="200" Height="60" Margin="10"/>

                <Button Content="Send API Request" Height="60"
                                   Margin="10" Command="{Binding SendCommand}" Width="250"/>
            </StackPanel>
            
            
        </Grid>

        <Grid Grid.Column="1">
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="10" BorderBrush="Black" BorderThickness="2">
                <TextBox TextWrapping="Wrap" FontSize="20"
                
                Text="{Binding Text}" Margin="10"
                />
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
